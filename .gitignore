# ==========================================
# Git Ignore - Application-Mobile-Services-Immobilier
# ==========================================

# --- Flutter & Dart ---
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/
**/doc/api/
**/*.map.json
**/*.symbols
.widget_preview/

# Android generated in Flutter / React Native
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/GeneratedPluginRegistrant.kt
**/android/captures/
**/android/gradlew
**/android/gradlew.bat

# iOS generated
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/DerivedData/
**/ios/.symlinks/
**/ios/Pods/
**/.swiftpm/

# macOS / Windows / Linux desktop generated
**/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# --- React Native & Node (pour la future application) ---
**/node_modules/
**/.expo/
**/.expo-shared/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# --- IDE & Éditeurs ---
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.sublime-project
*.sublime-workspace

# --- Fichiers système & temporaires ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.tmp
*.bak

# --- Clés, Secrets & Certificats ---
*.jks
*.keystore
*.p12
*.key
*.mobileprovision
*.env
*.env.*
!*.env.example
