rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properties collection:
    // Anyone can read listings (public catalog)
    // Authenticated users can create new listings
    // Only the property owner or an admin can update or delete
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        request.auth.token.role == 'ADMIN'
      );
    }

    // User profiles collection:
    // Any authenticated user can read profiles (e.g. to display agent/owner info)
    // Only the user themselves can write their own profile
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // User favorites subcollection:
      // STRICT ISOLATION: A user can ONLY read and write their own favorites subcollection!
      match /favorites/{propertyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Contact requests collection:
    // Visitors and logged-in users can submit a contact request
    // Only the sender or the property owner can read / update status
    match /contact_requests/{requestId} {
      allow create: if true;
      allow read, update: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.propertyOwnerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.propertyOwnerId == request.auth.uid ||
        request.auth.token.role == 'ADMIN'
      );
    }
  }
}
