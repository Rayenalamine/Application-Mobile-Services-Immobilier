# ============================================================
# DARLINK — CONFIGURATION FIREBASE CLOUD (PLACEHOLDERS ONLY)
# Copiez ce fichier vers .env et remplacez les valeurs par vos identifiants réels.
# ATTENTION : Ne committez JAMAIS votre fichier .env dans Git.
# ============================================================

# Identifiants Firebase pour les scripts de test et d'administration
FIREBASE_API_KEY=your-firebase-web-api-key-here
FIREBASE_PROJECT_ID=darlink-74715

# Configuration Publique Expo / React Native
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key-here
EXPO_PUBLIC_FIREBASE_PROJECT_ID=darlink-74715
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=darlink-74715.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=darlink-74715.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Instructions de configuration :
# 1. Console Firebase : https://console.firebase.google.com/
# 2. Paramètres du projet > Général > Clé API Web
# 3. Vos applications > Copier la configuration Web
